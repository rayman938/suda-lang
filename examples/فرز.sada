قيم = [5, 2, 4, 1]
نهاية = طول(قيم)
طالما نهاية > 1:
    موضع = 0
    طالما موضع < نهاية - 1:
        إذا قيم[موضع] > قيم[موضع + 1]:
            مؤقت = قيم[موضع]
            قيم[موضع] = قيم[موضع + 1]
            قيم[موضع + 1] = مؤقت
        موضع = موضع + 1
    نهاية = نهاية - 1
اطبع(قيم)
