# قاموس المنتجات، تحديث الكمية، وتجاوز العناصر غير المتاحة.
منتجات = [
    {"اسم": "دفتر", "كمية": 4, "سعر": 2.5},
    {"اسم": "قلم", "كمية": 0, "سعر": 1},
    {"اسم": "مسطرة", "كمية": 3, "سعر": 1.5}
]

سلة = {}
لكل منتج في منتجات:
    إذا منتج["كمية"] == 0:
        استمر
    سلة[منتج["اسم"]] = منتج["كمية"]
    اطبع("متاح:", منتج["اسم"], "السعر:", منتج["سعر"])

اطبع("المنتجات المتاحة:", مفاتيح(سلة))
